# ============================================================================
# Bike Copilot - Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure with your actual values
# NEVER commit the .env file to version control!

# ============================================================================
# Core Application Settings
# ============================================================================

# Database configuration (SQLite by default, can use PostgreSQL)
APP_DB_URL=sqlite:///./app.db
# APP_DB_URL=postgresql://user:pass@localhost/bikecopilot

# Output directory for generated files (quotes, reports)
APP_OUT_DIR=out

# Prefer in-stock items in search results (0 or 1)
APP_PREFER_IN_STOCK=1

# Synonyms configuration file path
APP_SYNONYMS=app/synonyms.yaml

# VAT rate for quotes (e.g., 0.22 for 22%)
APP_VAT=0.22

# ============================================================================
# Security & Authentication
# ============================================================================

# Basic Auth - Protects /quote, /kpi/*, and /files/* endpoints
# Both must be set to enable authentication
APP_BASIC_USER=admin
APP_BASIC_PASS=secure-password-change-me

# API rate limiting (requests per minute)
APP_RATE_LIMIT=60

# CORS allowed origins (comma-separated)
APP_CORS_ORIGINS=http://localhost:7860,http://localhost:7861,http://localhost:8000

# ============================================================================
# Dealer Configuration - RMS
# ============================================================================

# RMS dealer base URL (B2B portal)
DEALER_RMS_BASE_URL=https://b2b.rms.it

# Authentication mode: none|basic|cookie|form
DEALER_RMS_AUTH_MODE=form

# Credentials for RMS (only if AUTH_MODE is basic or form)
DEALER_RMS_USERNAME=your-rms-username
DEALER_RMS_PASSWORD=your-rms-password

# Cookie value for RMS (only if AUTH_MODE is cookie)
# Format: "session=abc123; auth=xyz789"
DEALER_RMS_COOKIE=

# ============================================================================
# Dealer Configuration - Ciclodiffusione
# ============================================================================

# Ciclodiffusione dealer base URL
DEALER_CICLODIFFUSIONE_BASE_URL=https://www.ciclodiffusione.com

# Authentication mode: none|basic|cookie|form
DEALER_CICLODIFFUSIONE_AUTH_MODE=form

# Credentials for Ciclodiffusione
DEALER_CICLODIFFUSIONE_USERNAME=your-ciclodiffusione-username
DEALER_CICLODIFFUSIONE_PASSWORD=your-ciclodiffusione-password

# Cookie value for Ciclodiffusione (if using cookie auth)
DEALER_CICLODIFFUSIONE_COOKIE=

# ============================================================================
# Dealer Configuration - CicloPromo
# ============================================================================

# CicloPromo dealer base URL
DEALER_CICLOPROMO_BASE_URL=https://shop.ciclopromo.com

# Authentication mode: none|basic|cookie|form
DEALER_CICLOPROMO_AUTH_MODE=form

# Credentials for CicloPromo
DEALER_CICLOPROMO_USERNAME=your-ciclopromo-username
DEALER_CICLOPROMO_PASSWORD=your-ciclopromo-password

# Cookie value for CicloPromo (if using cookie auth)
DEALER_CICLOPROMO_COOKIE=

# ============================================================================
# Dealer Configuration - Bikeparts
# ============================================================================

# Bikeparts dealer base URL
DEALER_BIKEPARTS_BASE_URL=https://www.bikeparts.com

# Authentication mode: none|basic|cookie|form
DEALER_BIKEPARTS_AUTH_MODE=none

# Credentials for Bikeparts (if required)
DEALER_BIKEPARTS_USERNAME=
DEALER_BIKEPARTS_PASSWORD=

# Cookie value for Bikeparts (if using cookie auth)
DEALER_BIKEPARTS_COOKIE=

# ============================================================================
# Web Scraping Configuration
# ============================================================================

# Default user agent for web scraping
WEB_USER_AGENT=BikeCopilotBot/1.0 (Compatible; +https://github.com/yourusername/bike-copilot)

# Request timeout in seconds
WEB_TIMEOUT=30

# Delay between requests in seconds (be respectful!)
WEB_DELAY=1.0

# Max pages to fetch in pagination
WEB_MAX_PAGES=10

# Retry attempts for failed requests
WEB_RETRY_ATTEMPTS=3

# ============================================================================
# Performance & Optimization
# ============================================================================

# Maximum number of suppliers for order optimization
OPTIMIZE_MAX_SUPPLIERS=3

# Default optimization mode: best_price|min_suppliers|fastest
OPTIMIZE_DEFAULT_MODE=best_price

# Cache TTL in seconds (0 to disable)
CACHE_TTL=3600

# Database connection pool size
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=INFO

# Log file path (empty for stdout only)
LOG_FILE=logs/app.log

# Enable performance profiling (0 or 1)
ENABLE_PROFILING=0

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ============================================================================
# Email Configuration (for notifications)
# ============================================================================

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@bikecopilot.com

# Email notifications
NOTIFY_ON_ERROR=admin@example.com
NOTIFY_ON_SYNC_COMPLETE=ops@example.com

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (0 or 1) - NEVER use in production!
DEBUG=0

# Enable SQL echo (0 or 1) - shows all SQL queries
SQL_ECHO=0

# Mock mode - uses synthetic data instead of real dealers (0 or 1)
MOCK_MODE=0

# Test database URL (for running tests)
TEST_DB_URL=sqlite:///./test.db

# ============================================================================
# Docker & Deployment
# ============================================================================

# Container registry
DOCKER_REGISTRY=docker.io/yourusername

# Environment: development|staging|production
ENVIRONMENT=development

# Instance ID (for multi-instance deployments)
INSTANCE_ID=primary

# Health check endpoint token
HEALTH_CHECK_TOKEN=random-secure-token

# ============================================================================
# Feature Flags
# ============================================================================

# Enable new PN-first UI (0 or 1)
FEATURE_PN_FIRST_UI=1

# Enable dealer sync automation (0 or 1)
FEATURE_AUTO_SYNC=1

# Enable KPI dashboard (0 or 1)
FEATURE_KPI_DASHBOARD=1

# Enable order optimization (0 or 1)
FEATURE_ORDER_OPTIMIZATION=1

# Enable PDF generation (0 or 1)
FEATURE_PDF_GENERATION=1

# ============================================================================
# Scheduled Tasks (Cron)
# ============================================================================

# Enable scheduled tasks (0 or 1)
ENABLE_SCHEDULER=0

# Dealer sync schedule (cron format)
# Default: every 6 hours
SYNC_SCHEDULE=0 */6 * * *

# Database cleanup schedule (cron format)
# Default: daily at 2 AM
CLEANUP_SCHEDULE=0 2 * * *

# KPI report schedule (cron format)
# Default: daily at 8 AM
KPI_REPORT_SCHEDULE=0 8 * * *

# ============================================================================
# API Keys & External Services
# ============================================================================

# Google Maps API key (for shipping calculations)
GOOGLE_MAPS_API_KEY=

# Currency conversion API key
CURRENCY_API_KEY=

# Translation service API key
TRANSLATION_API_KEY=

# Analytics tracking ID
ANALYTICS_ID=

# ============================================================================
# Notes
# ============================================================================
#
# 1. Authentication Modes:
#    - none: No authentication required
#    - basic: HTTP Basic Authentication
#    - cookie: Cookie-based session authentication
#    - form: Form-based login with POST/GET
#
# 2. Dealer Configuration:
#    - Each dealer needs BASE_URL and AUTH_MODE at minimum
#    - Credentials are only needed based on AUTH_MODE
#    - Cookie values should include all necessary cookies
#
# 3. Security Best Practices:
#    - Use strong passwords (min 16 chars, mixed case, numbers, symbols)
#    - Rotate credentials regularly
#    - Never commit actual credentials to version control
#    - Use environment-specific .env files for different deployments
#
# 4. Performance Tuning:
#    - Adjust WEB_DELAY based on dealer's rate limits
#    - Increase DB_POOL_SIZE for high-traffic deployments
#    - Enable caching with appropriate CACHE_TTL
#
# 5. Monitoring:
#    - Set up SENTRY_DSN for production error tracking
#    - Configure email notifications for critical events
#    - Use LOG_LEVEL=DEBUG only for troubleshooting
#
# ============================================================================