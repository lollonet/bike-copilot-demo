#!/usr/bin/env bash
set -euo pipefail

# 1. Capture Git Args
remote_name="${1:-}"
remote_url="${2:-}"

# 2. Run Local CI (from PR #67 SOTA Workflow)
echo "🚀 Running Pre-push CI Check..."
if ! make ci-fast; then
    echo "❌ Local CI failed. Push aborted. Run 'make ci-fast' to debug."
    exit 1
fi
echo "✅ Local CI passed."

# 3. Governance: Block direct pushes to 'main'
# Allow override with ALLOW_MAIN_PUSH=1 or GIT_ALLOW_MAIN_PUSH=1.
if [[ "${ALLOW_MAIN_PUSH:-}" == "1" || "${GIT_ALLOW_MAIN_PUSH:-}" == "1" ]]; then
  exit 0
fi

block=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip empty lines
  [[ -z "${remote_ref:-}" ]] && continue
  if [[ "${remote_name}" == "origin" && "${remote_ref}" == "refs/heads/main" ]]; then
    block=1
  fi
done

if [[ $block -eq 1 ]]; then
  echo "✋ Push to 'origin/main' blocked by repository policy." >&2
  echo "Use a branch and open a PR (REQ-### mandatory in commits)." >&2
  echo "Suggestions:" >&2
  echo "  git checkout -b feat/feature-name" >&2
  echo "  git push -u origin HEAD" >&2
  echo "  gh pr create -t 'REQ-###: Title' -b 'Description'" >&2
  echo "(Temporary bypass only if critical: ALLOW_MAIN_PUSH=1 git push origin main)" >&2
  exit 1
fi

exit 0
